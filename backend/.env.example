# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
FRONTEND_URL=http://localhost:3000/auth?message=email-confirmed
# Public Strapi origin used for admin and uploaded-asset URLs.
PUBLIC_URL=http://localhost:1337
# Enable when Strapi runs behind Railway's reverse proxy.
IS_PROXIED=false

# Strapi secrets.
# For an existing/shared project database, copy these from the existing backend/.env.
# Generate new values only for a new standalone environment.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
# Dedicated HMAC key for password attempt identifiers and trusted client-IP
# proofs. Use the same random 32+ byte value in Next.js and every Strapi instance.
PASSWORD_RATE_LIMIT_SECRET=

# Existing/shared project database. Fill this in for normal development.
# Production refuses to start unless this is explicitly PostgreSQL with DATABASE_URL set.
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Cloudflare R2 uploads. Leave R2_* unset to use Strapi's local provider in development.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deal-rakyat-uploads
R2_PUBLIC_URL=https://media.dealrakyat.my

# Throwaway local SQLite only.
# This creates a blank local database, so Strapi will ask for a new admin profile.
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
