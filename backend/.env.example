# Server
HOST=0.0.0.0
PORT=1337
FRONTEND_URL=http://localhost:3000/auth?message=email-confirmed

# Strapi secrets. Generate unique values per environment.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=

# Local SQLite default
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# PostgreSQL example. Use these instead of SQLite for shared/staging/production environments.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_SCHEMA=public
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000
