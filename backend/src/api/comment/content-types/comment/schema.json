{
  "kind": "collectionType",
  "collectionName": "comments",
  "info": {
    "singularName": "comment",
    "pluralName": "comments",
    "displayName": "Comment"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "deal": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::deal.deal",
      "inversedBy": "comments"
    },
    "parentId": {
      "type": "string"
    },
    "authorViewerId": {
      "type": "string"
    },
    "authorUserId": {
      "type": "string"
    },
    "authorName": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "text",
      "required": true
    },
    "editedAt": {
      "type": "datetime"
    },
    "reportCount": {
      "type": "integer",
      "default": 0
    },
    "submissionKey": {
      "type": "string",
      "unique": true,
      "private": true
    },
    "reports": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment-report.comment-report",
      "mappedBy": "comment"
    },
    "likeCount": {
      "type": "integer",
      "default": 0
    },
    "likedBy": {
      "type": "json"
    }
  }
}
