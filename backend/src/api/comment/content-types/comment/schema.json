      "type": "string"
    },
    "authorViewerId": {
      "type": "string"
    },
    "authorUserId": {
      "type": "string"
    },
    "authorName": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "text",
      "required": true
    },
    "likeCount": {
      "type": "integer",
      "default": 0
    },
    "likedBy": {
      "type": "json"
    },
    "test": {
      "type": "text"
    }
  }
}
