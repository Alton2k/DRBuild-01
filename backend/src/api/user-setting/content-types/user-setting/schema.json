{
  "kind": "collectionType",
  "collectionName": "user_settings",
  "info": {
    "singularName": "user-setting",
    "pluralName": "user-settings",
    "displayName": "User Setting"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "userId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "ownerUsername": {
      "type": "string",
      "maxLength": 120
    },
    "ownerEmail": {
      "type": "email"
    },
    "avatarUrl": {
      "type": "text"
    },
    "displayName": {
      "type": "string",
      "maxLength": 48
    },
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "unique": true
    },
    "bio": {
      "type": "text"
    },
    "theme": {
      "type": "enumeration",
      "enum": ["dark", "light", "system"],
      "default": "system"
    },
    "notificationSettings": {
      "type": "json"
    },
    "privacySettings": {
      "type": "json"
    }
  }
}
